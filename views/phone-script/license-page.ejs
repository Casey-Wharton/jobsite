<div style="display: flex; height: calc(100vh - 78px); overflow: hidden;">
  <!-- Left Menu -->
  <div class="left-menu">
    <h2>Navigation</h2>
    <ul>
      <li>
        <a href="#" onclick="showSection(event, 'license-info')" class="menu-link active">License Info</a>
      </li>
      <li>
        <a href="#" onclick="showSection(event, 'application-info')" class="menu-link">Application Info</a>
      </li>
      <li>
        <a href="#" onclick="showSection(event, 'exam-info')" class="menu-link">Exam Info</a>
      </li>
      <li>
        <a href="#" onclick="showSection(event, 'course-info')" class="menu-link">Course Info</a>
      </li>
      <li>
        <a href="#" onclick="showSection(event, 'product-info')" class="menu-link">Product Info</a>
      </li>
    </ul>
  </div>

  <!-- Content Area -->
  <div class="content-area">
    <!-- Main Content -->
    <div class="main-content">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1><%= license.License %> in <%= state %></h1>
        <a href="/phone-script/<%= encodeURIComponent(state) %>/" class="back-button">Back to State Page</a>
      </div>

      <!-- License Info Section -->
      <div id="license-info" class="content-section">
        <div class="section-box red">
          <h2>License Info</h2>
          <ul>
            <!-- No dynamically attached fields -->
          </ul>
        </div>
      </div>

      <!-- Application Info Section -->
      <div id="application-info" class="content-section" style="display: none;">
        <div class="section-box yellow">
          <h2>Application Info</h2>
          <ul>
            <!-- No dynamically attached fields -->
          </ul>
        </div>
      </div>

      <!-- Exam Info Section -->
      <div id="exam-info" class="content-section" style="display: none;">
        <div class="section-box blue">
          <h2>Exam Info</h2>
          <ul>
            <!-- No dynamically attached fields -->
          </ul>
        </div>
      </div>

      <!-- Course Info Section -->
      <div id="course-info" class="content-section" style="display: none;">
        <div class="section-box">
          <h2>Course Info</h2>
          <ul>
            <!-- No dynamically attached fields -->
          </ul>
        </div>
      </div>

      <!-- Product Info Section -->
      <div id="product-info" class="content-section" style="display: none;">
        <div class="section-box">
          <h2>Product Info</h2>
          <ul>
            <!-- No dynamically attached fields -->
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="bottom-bar">
      <h3>Intake Form</h3>
      <div class="form-fields">
        <label>
          <span>First Name</span>
          <input type="text">
        </label>
        <label>
          <span>Last Name</span>
          <input type="text">
        </label>
        <label>
          <span>Email</span>
          <input type="email">
        </label>
        <label>
          <span>Phone Number</span>
          <input type="tel">
        </label>
        <button>Submit</button>
      </div>
    </div>
  </div>
</div>


<script>
  function showSection(event, sectionId) {
    // Prevent default anchor behavior
    event.preventDefault();

    // Hide all content sections
    document.querySelectorAll('.content-section').forEach(section => {
      section.style.display = 'none';
    });

    // Show the selected section
    document.getElementById(sectionId).style.display = 'block';

    // Remove active styling from all menu links
    document.querySelectorAll('.menu-link').forEach(link => {
      link.classList.remove('active');
    });

    // Highlight the active menu link
    event.target.classList.add('active');
  }

  // Default to showing the License Info section
  document.addEventListener('DOMContentLoaded', () => {
    showSection(new Event('DOMContentLoaded'), 'license-info');
  });
</script>

