<h1 class="page-title"><%= state %> Licenses</h1>

<!-- Legend and Filter Bar -->
<div class="legend-filter-bar">
    <!-- License Type Filter -->
    <div class="license-type-filter">
        <label>Only show:</label>
        <% const uniqueLicenseTypes = [...new Set(licenses.flatMap(license => license.licenseTypes))]; %>
        <% uniqueLicenseTypes.forEach(type => { %>
            <label class="filter-option">
                <input type="checkbox" class="license-type-filter-checkbox" value="<%= type %>">
                <%= type %>
            </label>
        <% }) %>
    </div>
    <div class="legend">
        <div class="legend-items">
            <span class="legend-item">
                <span class="symbol electrical">🗲</span>
                <span class="legend-text">= NASCLA Electrical</span>
            </span>
            <span class="legend-item">
                <span class="symbol builder">🔨</span>
                <span class="legend-text">= NASCLA Builder</span>
            </span>
        </div>
    </div>
</div>

<div class="license-layout">
    <!-- Left: License List -->
    <div class="license-list">
        <% if (licenses && licenses.length > 0) { %>
            <ul id="license-list">
                <% licenses.forEach(license => { %>
                    <li class="license-item" data-license-types="<%= license.licenseTypes.join(', ') %>">
                        <a 
                            class="license-link" 
                            href="/phone-script/<%= encodeURIComponent(state) %>/<%= encodeURIComponent(license.name) %>" 
                            data-license-types="<%= license.licenseTypes.join(', ') %>" 
                            data-permitted-work="<%= license.permittedWork %>">
                            <%= license.name %>
                        </a>
                        <% if (license.hasElectrical) { %> 
                            <span class="symbol electrical">🗲</span> 
                        <% } %>
                        <% if (license.hasBuilder) { %> 
                            <span class="symbol builder">🔨</span> 
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No licenses available for <%= state %>.</p>
        <% } %>
    </div>

    <!-- Right: Permitted Work -->
    <div class="hover-info-wrapper">
        <h2 class="hover-info-header">Permitted Work</h2>
        <div class="hover-info">
            <div id="hover-placeholder" class="hover-placeholder">
                Hover over a license to see details
            </div>
            <div id="hover-license-types" class="license-types hidden"></div>
            <p id="hover-permitted-work" class="hover-permitted-work hidden"></p>
        </div>
    </div>
</div>

<!-- Full-Width General State Information -->
<div class="general-state-info">
    <h2>General State Information</h2>
    <div><%- generalStateInfo %></div>
</div>

<style>
    /* Page Title */
    .page-title {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 20px;
        text-align: center;
    }

    /* Legend and Filter Bar */
    .legend-filter-bar {
        display: flex;
        flex-direction: column;
        gap: 10px;
        background-color: #fff;
        padding: 10px 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-bottom: 10px;
    }

    .legend {
        flex: 1;
    }

    .legend-items {
        display: flex;
        align-items: center;
        gap: 30px;
    }

    .legend-item {
        display: flex;
        align-items: center;
    }

    .symbol {
        font-size: 16px;
        margin-right: 5px;
    }

    .symbol.electrical {
        color: #FFA500;
    }

    .symbol.builder {
        color: #32CD32;
    }

    .legend-text {
        font-size: 16px;
        color: #555;
    }

    /* License Type Filter */
    .license-type-filter {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        color: #333;
    }

    .filter-option {
        margin-left: 10px;
    }

    /* License Layout */
    .license-layout {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .license-list {
        flex: 1;
    }

    .license-list ul {
        list-style: none;
        padding: 0;
    }

    .license-list li {
        margin-bottom: 20px;
    }

    .license-link {
        text-decoration: none;
        color: #007BFF;
        font-size: 16px;
    }

    .license-link:hover {
        color: #0056b3;
    }

    /* License Type Badges */
    .license-types {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
    }

    .license-types .license-type-badge {
        display: inline-block;
        padding: 5px 10px;
        font-size: 14px;
        font-weight: bold;
        color: #fff; /* White text */
        border-radius: 12px; /* Rounded edges */
        background: linear-gradient(to right, #667ead, #4b5c7d); /* Gradient background */
    }

    /* Permitted Work */
    .hover-info-wrapper {
        flex: 1;
    }

    .hover-info-header {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .hover-info {
        border: 1px solid #ddd;
        padding: 15px;
        border-radius: 8px;
        background-color: #f9f9f9;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 150px;
    }

    .hover-placeholder {
        font-size: 16px;
        color: #555;
        text-align: center;
    }

    .hidden {
        display: none;
    }

    .hover-info.active {
        justify-content: flex-start;
        align-items: flex-start;
        flex-direction: column;
    }

    .hover-permitted-work {
        font-size: 18px;
        line-height: 1.6;
        letter-spacing: 0.5px;
        color: #333;
        margin-top: 10px;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const licenseLinks = document.querySelectorAll('.license-link');
    const hoverPlaceholder = document.getElementById('hover-placeholder');
    const licenseTypesContainer = document.getElementById('hover-license-types');
    const permittedWorkSpan = document.getElementById('hover-permitted-work');
    const hoverInfo = document.querySelector('.hover-info');
    const checkboxes = document.querySelectorAll('.license-type-filter-checkbox');
    const licenseItems = document.querySelectorAll('.license-item');

    // Hover functionality
    licenseLinks.forEach(link => {
        link.addEventListener('mouseover', () => {
            const licenseTypes = link.getAttribute('data-license-types').split(', ');
            const permittedWork = link.getAttribute('data-permitted-work');

            hoverPlaceholder.classList.add('hidden');
            licenseTypesContainer.classList.remove('hidden');
            permittedWorkSpan.classList.remove('hidden');
            hoverInfo.classList.add('active');

            licenseTypesContainer.innerHTML = '';
            licenseTypes.forEach(type => {
                const badge = document.createElement('span');
                badge.className = 'license-type-badge';
                badge.textContent = type;
                licenseTypesContainer.appendChild(badge);
            });

            permittedWorkSpan.textContent = permittedWork || 'No permitted work details available';
        });

        link.addEventListener('mouseout', () => {
            hoverPlaceholder.classList.remove('hidden');
            licenseTypesContainer.classList.add('hidden');
            permittedWorkSpan.classList.add('hidden');
            hoverInfo.classList.remove('active');
        });
    });

    // Filter functionality
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
            const selectedTypes = Array.from(checkboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.value);

            licenseItems.forEach(item => {
                const itemTypes = item.getAttribute('data-license-types').split(', ');

                // Check if the item includes all selected types
                const matches = selectedTypes.every(type => itemTypes.includes(type));
                item.style.display = selectedTypes.length === 0 || matches ? '' : 'none';
            });
        });
    });
});

</script>
