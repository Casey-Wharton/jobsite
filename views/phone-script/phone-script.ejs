<div class="container">
    <!-- Main content -->
    <div class="main-content">
        <h2>Pick a State</h2>
        
        <!-- Legend -->
        <div class="legend">
            <div class="legend-items">
                <span class="legend-item">
                    <span class="symbol electrical">🗲</span>
                    <span class="legend-text">= NASCLA Electrical</span>
                </span>
                <span class="legend-item">
                    <span class="symbol builder">🔨</span>
                    <span class="legend-text">= NASCLA Commercial Builder</span>
                </span>
            </div>
            <hr class="legend-divider">
        </div>

        <!-- State List -->
        <ul>
            <% records.forEach(record => { %>
                <li>
                    <a href="/phone-script/<%= record.state %>">
                        <%= record.state %>
                    </a>
                    <% if (record.hasElectrical) { %> 
                        <span class="symbol electrical">🗲</span> 
                    <% } %>
                    <% if (record.hasBuilder) { %> 
                        <span class="symbol builder">🔨</span> 
                    <% } %>
                </li>
            <% }) %>
        </ul>
    </div>
</div>

<style>
    /* General layout */
    .container {
        display: flex;
        flex-direction: column;
        padding: 20px;
    }

    /* Legend styling */
    .legend {
        margin-bottom: 20px;
        padding: 0;
    }

    .legend-items {
        display: flex;
        align-items: center;
        gap: 40px; /* Space between legend items */
    }

    .legend-item {
        display: flex;
        align-items: center;
    }

    .symbol {
        font-size: 16px; /* Small symbol size */
        margin-right: 5px; /* Tighten space between symbol and equals sign */
    }

    .symbol.electrical {
        color: #FFA500; /* Orange for 🗲 */
    }

    .symbol.builder {
        color: #32CD32; /* Green for 🔨 */
    }

    .legend-text {
        font-size: 16px; /* Text size matches symbol */
        color: #555;
    }

    .legend-divider {
        margin-top: 10px;
        border: none;
        border-top: 2px solid #ddd;
    }

    /* Main content styling */
    .main-content h2 {
        margin-bottom: 20px;
        color: #333;
    }

    .main-content ul {
        list-style: none;
        padding: 0;
    }

    .main-content li {
        margin-bottom: 10px;
    }

    .main-content a {
        text-decoration: none;
        color: #007BFF;
        font-size: 16px;
    }

    .main-content a:hover {
        color: #0056b3;
        text-decoration: underline;
    }

    .symbol {
        font-size: 18px;
    }
</style>
