<h2 style="margin-bottom: 20px;">Booksets</h2>

<div style="display: flex; gap: 12px; align-items: center; margin-bottom: 10px;">
    <button id="generateAllBtn" class="action-btn">Generate All Bookset Images</button>
    <button id="clearS3Btn" class="danger-btn">Clear S3 Image Folder</button>
    <p style="margin: 0;"><strong><%= fileCount %></strong> file<%= fileCount === 1 ? '' : 's' %> currently in S3</p>
</div>

<div id="progressContainer" style="margin-top: 10px; display: none;">
    <div style="border: 1px solid #ccc; width: 100%; height: 25px; border-radius: 4px; overflow: hidden;">
        <div id="progressBar" style="height: 100%; width: 0%; background: #4caf50; transition: width 0.2s;"></div>
    </div>
    <p id="progressText" style="margin-top: 5px;">0%</p>
    <p id="elapsedTime" style="margin-top: 5px; font-style: italic;">Elapsed time: 0s</p>
</div>

<ul>
    <% booksets.forEach(bookset => { %>
        <li>
            <a href="/images/<%= bookset.id %>"><%= bookset.name %></a>
        </li>
    <% }) %>
</ul>

<style>
    .action-btn {
        padding: 10px 16px;
        background-color: #1976d2;
        border: none;
        border-radius: 4px;
        color: white;
        cursor: pointer;
        font-weight: bold;
        transition: background-color 0.2s ease;
    }

    .action-btn:hover {
        background-color: #1565c0;
    }

    .danger-btn {
        padding: 10px 16px;
        background-color: #d32f2f;
        border: none;
        border-radius: 4px;
        color: white;
        cursor: pointer;
        font-weight: bold;
        transition: background-color 0.2s ease;
    }

    .danger-btn:hover {
        background-color: #b71c1c;
    }
</style>

<script>
    const btn = document.getElementById('generateAllBtn');
    const clearBtn = document.getElementById('clearS3Btn');
    const container = document.getElementById('progressContainer');
    const bar = document.getElementById('progressBar');
    const text = document.getElementById('progressText');
    const elapsedDisplay = document.getElementById('elapsedTime');

    let timerInterval;
    let startTime;

    clearBtn.addEventListener('click', async () => {
        if (confirm('Are you sure you want to delete all images in the S3 folder?')) {
            const res = await fetch('/images/clear-s3-images', { method: 'POST' });
            const data = await res.json();
            alert(`Deleted ${data.deleted} file(s) from S3.`);
            location.reload();
        }
    });

    btn.addEventListener('click', async () => {
        btn.disabled = true;
        container.style.display = 'block';
        bar.style.width = '0%';
        text.innerText = '0%';
        elapsedDisplay.innerText = 'Elapsed time: 0s';

        startTime = Date.now();
        timerInterval = setInterval(() => {
    const totalSeconds = Math.floor((Date.now() - startTime) / 1000);
    const minutes = String(Math.floor(totalSeconds / 60)).padStart(2, '0');
    const seconds = String(totalSeconds % 60).padStart(2, '0');
    elapsedDisplay.innerText = `Elapsed time: ${minutes}:${seconds}`;
}, 1000);

        const source = new EventSource('/images/progress');

        source.onmessage = (event) => {
            const data = JSON.parse(event.data);
            const pct = data.progress;
            bar.style.width = pct + '%';
            text.innerText = pct + '%';

            if (pct >= 100) {
                clearInterval(timerInterval);
                source.close();
                btn.disabled = false;
            }
        };

        source.onerror = (err) => {
            console.error('Progress stream error:', err);
            clearInterval(timerInterval);
            source.close();
            btn.disabled = false;
            text.innerText = 'Progress unavailable';
        };

        try {
            const response = await fetch('/images/generate-all', { method: 'POST' });
            if (!response.ok) throw new Error('Start request failed');
        } catch (err) {
            console.error('Error triggering generation:', err);
            clearInterval(timerInterval);
            btn.disabled = false;
            alert('Something went wrong. Check console.');
        }
    });
</script>