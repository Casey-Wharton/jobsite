<div class="view-bookset-grid">
    <div class="view-bookset-cell">
        <% if (!isScreenshot) { %>
            <h2><%= bookset.name %></h2>
            <a href="/images">Back to All Booksets</a>
            <button onclick="generateSnapshot()">Generate Screenshot</button>
            <br>
            <% } %>            
    </div>
    <div>
        <h3>Bookset Image:</h3>
        <!-- DEBUG: <%= JSON.stringify(books) %> -->
        <div class="background-div">
            <div class="book-container">
                <% let imageCount = 0;
                books.forEach(book => {
                    imageCount++; %>
                    <img class="book-image" src="<%= book.coverImage %>" alt="Book Cover">
                    <% if(imageCount === completeRow) {
                        const emptyDivsCount = columns - (totalBooks - completeRow);
                        Array.from({ length: emptyDivsCount }).forEach(() => { %>
                            <div></div>
                    <% }); } %>
                <% }); %>
            </div>
        </div>
    </div>
</div>
<% if (!isScreenshot) { %>
    <div id="snapshot-output" style="margin-top: 20px;"></div>
<% } %>

<style>
.view-bookset-grid {
    display: flex;
}
.view-bookset-cell {
    flex: 1;
}
.background-div {
    width: 700px;
    height: 700px;
    background-image: url('https://internalpage.s3.amazonaws.com/bookset+background.png');
    background-size: cover;
    display: flex;
    flex-direction: column;
    padding: 10px;
    box-sizing: border-box;
}
.book-container {
    display: grid;
    gap: 10px;
}
.book-container img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    grid-column: span 2;
    filter: drop-shadow(2px 2px 5px rgba(0, 0, 0, 0.4));
}
</style>

<script>
    function calculateGrid() {
        const container = document.querySelector('.book-container');
        const items = container.children.length;

        const containerWidth = 680;
        const containerHeight = 700 - 20;

        let columns = Math.ceil(Math.sqrt(items)) * 2;
        let rows = Math.ceil(items / (columns / 2));

        let gap = 10;
        let totalGapWidth = (columns - 1) * gap;
        let totalGapHeight = (rows - 1) * gap;

        let availableWidth = containerWidth - totalGapWidth;
        let availableHeight = containerHeight - totalGapHeight;

        let cellWidth = availableWidth / columns;
        let cellHeight = availableHeight / rows;

        while (cellHeight > availableHeight / rows) {
            rows++;
            totalGapHeight = (rows - 1) * gap;
            cellHeight = (availableHeight - totalGapHeight) / rows;
        }

        container.style.gridTemplateColumns = `repeat(${columns}, ${cellWidth}px)`;
        container.style.gridTemplateRows = `repeat(${rows}, ${cellHeight}px)`;
    }

    window.addEventListener('DOMContentLoaded', calculateGrid);
    window.addEventListener('resize', calculateGrid);

    function generateSnapshot() {
        const button = event.target;
        button.disabled = true;
        button.innerText = 'Generating...';

        fetch(window.location.pathname + '/snapshot')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const img = document.createElement('img');
                    img.src = data.path;
                    img.style.border = '1px solid #ccc';
                    img.style.marginTop = '20px';
                    img.style.maxWidth = '700px';

                    document.getElementById('snapshot-output').innerHTML = '';
                    document.getElementById('snapshot-output').appendChild(img);
                } else {
                    alert('Failed to generate image.');
                }
            })
            .catch(err => {
                alert('Error generating image.');
                console.error(err);
            })
            .finally(() => {
                button.disabled = false;
                button.innerText = 'Generate Screenshot';
            });
    }

</script>