<div style="padding: 20px; max-width: 800px; margin: auto;">
    <h2>Manage Books</h2>
    <button onclick="openBookSelector()" style="margin-bottom: 16px; padding: 8px 16px; background-color: #007acc; color: white; border: none; border-radius: 4px; cursor: pointer;">
      + Add New Book
    </button>
    
    <div id="popup-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.4); z-index: 9998;"></div>

    <div id="book-popup" style="display: none; position: fixed; top: 10%; left: 50%; transform: translateX(-50%); width: 600px; background: #ebebeb; border-radius: 8px; padding: 20px; box-shadow: 0 0 20px rgba(0,0,0,0.5); z-index: 9999;">
      <div style="text-align: right;">
        <button onclick="closeBookSelector()" style="background: none; border: none; font-size: 20px; cursor: pointer;">×</button>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <h3 style="margin: 0;">Select a Book</h3>
        <input type="text" id="book-search" placeholder="Search..." style="padding: 6px; width: 200px; border-radius: 4px; border: 1px solid #ccc;">
      </div>      
      <ul id="book-list" style="max-height: 300px; overflow-y: auto; padding: 0; list-style: none; background-color: white;">
        <% allBooks.forEach(book => { %>
          <li onclick="chooseBook(<%= book.id %>, '<%= book.name.replace(/'/g, "\\'") %>')" style="padding: 8px 12px; border-bottom: 1px solid #ddd; cursor: pointer;">
            <strong><%= book.id %></strong>: <%= book.name %>
          </li>
        <% }) %>
      </ul>
    </div>    
    
    <div id="mode-popup" style="display: none; position: fixed; top: 30%; left: 50%; transform: translateX(-50%); background: white; padding: 20px; border-radius: 8px; box-shadow: 0 0 20px rgba(0,0,0,0.4); text-align: center; z-index: 9999;">
      <p id="selected-book-label"></p>
      <button onclick="createPresentation('code')" style="margin-right: 10px;">Use Code Numbering</button>
      <button onclick="createPresentation('page')">Use Page Numbering</button>
    </div>
    
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="background-color: #f4f4f4;">
          <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ccc;">Book ID</th>
          <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ccc;">Book Name</th>
          <th style="padding: 8px; border-bottom: 1px solid #ccc;"></th>
        </tr>
      </thead>
      <tbody>
        <% presentationFiles.forEach(p => { %>
          <tr>
            <td style="padding: 8px;"><%= p.bookId %></td>
            <td style="padding: 8px;"><%= p.bookName %></td>
            <td style="padding: 8px; display: flex; gap: 8px;">
                <form method="GET" action="/presentations/edit/<%= p.bookId %>">
                  <button type="submit" style="padding: 6px 12px; background-color: #4caf50; color: white; border: none; border-radius: 4px; cursor: pointer;">
                    Edit
                  </button>
                </form>
              </td>              
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>  

  <script>
    let selectedBookId = null;
  
    function openBookSelector() {
      document.getElementById("book-popup").style.display = "block";
      document.getElementById("popup-overlay").style.display = "block";
    }
  
    function closeBookSelector() {
      document.getElementById("book-popup").style.display = "none";
      document.getElementById("popup-overlay").style.display = "none";
    }
  
    function chooseBook(id, name) {
      selectedBookId = id;
      closeBookSelector();
      document.getElementById("selected-book-label").textContent = `Create presentation for: ${name}`;
      document.getElementById("mode-popup").style.display = "block";
    }
  
    function createPresentation(mode) {
      fetch(`/presentations/create-new-book/${selectedBookId}?mode=${mode}`, {
        method: "POST"
      }).then(() => {
        location.reload();
      }).catch(err => {
        alert("Error creating presentation");
        console.error(err);
      });
    }
  
    // Close when clicking outside the popup
    document.addEventListener("click", function (event) {
      const popup = document.getElementById("book-popup");
      const overlay = document.getElementById("popup-overlay");
  
      if (
        popup.style.display === "block" &&
        !popup.contains(event.target) &&
        !event.target.closest('button[onclick="openBookSelector()"]')
      ) {
        closeBookSelector();
      }
    });

    // Live filter
document.addEventListener('DOMContentLoaded', () => {
  const searchInput = document.getElementById('book-search');
  const bookList = document.getElementById('book-list');

  searchInput.addEventListener('input', () => {
    const search = searchInput.value.toLowerCase();
    const items = bookList.querySelectorAll('li');

    items.forEach(item => {
      const text = item.textContent.toLowerCase();
      item.style.display = text.includes(search) ? 'block' : 'none';
    });
  });
});

  </script>  